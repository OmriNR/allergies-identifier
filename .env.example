# Copy this file to `.env` (same directory as docker-compose.yaml) and
# adjust values before running ./build.sh or docker compose up.

# MongoDB (leave user/password empty for no-auth local dev)
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=aller_scan

# aller-scan-api
PROJECT_NAME=aller-scan-api
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changeme123
SECRET_KEY=

# aller-scan (frontend build-time vars, baked into the static bundle)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_FOOD_FACTS_API_BASE_URL=https://world.openfoodfacts.net/api/v3.6
