# Local Ollama server used for allergy-risk reasoning.
# If Ollama is running in Docker with -p 11434:11434, the default below works.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=800
# Only relevant if you switch to a reasoning model (e.g. qwen3) — plain
# instruct models like the default reject this field with a 400, so keep it
# false unless you switch. If you do: disabling thinking on those models to
# save time was observed to produce incorrect allergy assessments; set this
# true and raise OLLAMA_NUM_PREDICT instead.
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=30m
OLLAMA_REQUEST_TIMEOUT=60.0

# Local vector store (Chroma, persisted to disk)
CHROMA_PERSIST_DIR=./data/chroma
DOCUMENTS_REGISTRY_PATH=./data/documents.json

CHUNK_SIZE=800
CHUNK_OVERLAP=120
DEFAULT_TOP_K=5

CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=512

MAX_UPLOAD_BYTES=20971520
