{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: Debug (uvicorn)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}/aller-scan-api",
            "python": "${workspaceFolder}/aller-scan-api/.venv/bin/python",
            "jinja": true,
            "justMyCode": true
        }
    ]
}
